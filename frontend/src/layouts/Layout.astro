---
import "../styles/global.css";
import { Toaster } from "@/components/ui/sonner";

interface Props {
  title: string;
}

const { title = "FinPath" } = Astro.props;
---

<!doctype html>
<html lang="pl" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-background font-sans antialiased">
    <header class="border-b border-border bg-card/60 backdrop-blur supports-[backdrop-filter]:bg-card/80">
      <div class="container mx-auto flex flex-wrap items-center justify-between gap-4 px-4 py-4">
        <a href="/" class="text-lg font-semibold">FinPath</a>
        <nav class="flex flex-wrap items-center gap-3 text-sm">
          <a class="rounded-md px-3 py-2 hover:bg-muted" href="/budgets/plan">Planowanie budżetu</a>
          <a class="rounded-md px-3 py-2 hover:bg-muted" href="/transactions">Transakcje</a>
          <a class="rounded-md px-3 py-2 hover:bg-muted" href="/reports">Raporty</a>
          <a class="rounded-md px-3 py-2 hover:bg-muted text-destructive" href="/logout">Wyloguj</a>
        </nav>
      </div>
    </header>
    <slot />
    <Toaster richColors />
  </body>
</html>

<style is:global>
  html {
    height: 100%;
    margin: 0;
  }
  body {
    min-height: 100%;
    margin: 0;
  }
</style>
