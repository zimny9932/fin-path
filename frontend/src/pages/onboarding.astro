---
import Layout from "@/layouts/Layout.astro";
import OnboardingForm from "@/components/OnboardingForm.tsx";
---

<Layout title="Account Setup | fin-path">
  <main
    class="container flex-grow max-w-2xl px-4 mx-auto"
  >
    <div class="py-20 space-y-6">
      <div class="space-y-2 text-center">
        <h1 class="text-3xl font-bold">Account Setup</h1>
        <p class="text-muted-foreground">
          Please select the starting day of your monthly billing cycle.
        </p>
      </div>
      <OnboardingForm client:load />
    </div>
  </main>
</Layout>
